+
+std::string normalise_relation_name(std::string value) {
+  value = lower(trim(std::move(value)));
+  for (auto& ch : value) {
+    if (std::isalnum(static_cast<unsigned char>(ch))) continue;
+    ch = '_';
+  }
+  std::string out;
+  bool underscore = false;
+  for (char ch : value) {
+    if (ch == '_') {
+      if (!underscore && !out.empty()) out.push_back(ch);
+      underscore = true;
+    } else {
+      out.push_back(ch); underscore = false;
+    }
+  }
+  while (!out.empty() && out.back() == '_') out.pop_back();
+  return out;
+}

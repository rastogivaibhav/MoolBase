+std::vector<std::string> split_source_units(const std::string& text) {
+  // Preserve one-record-per-line structured and tokenised datasets. Generic
+  // edge records may contain decimal points or punctuation that are data, not
+  // sentence boundaries.
+  std::vector<std::string> lines;
+  std::istringstream stream(text);
+  std::string line;
+  bool structured = false;
+  while (std::getline(stream, line)) {
+    line = trim(line);
+    if (line.empty()) continue;
+    const auto l = lower(line);
+    if ((!line.empty() && (line.front() == '{' || line.front() == '<')) ||
+        l.find("[subj]") != std::string::npos ||
+        l.find("[subject]") != std::string::npos ||
+        line.find('\t') != std::string::npos ||
+        std::count(line.begin(), line.end(), '|') >= 2) {
+      structured = true;
+    }
+    lines.push_back(line);
+  }
+  if (structured && !lines.empty()) return lines;
+  return split_sentences(text);
+}

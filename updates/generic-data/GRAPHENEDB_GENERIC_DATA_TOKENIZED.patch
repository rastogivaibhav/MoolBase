+// Domain-neutral relation ingestion. These formats allow Graphene to ingest
+// arbitrary business, scientific, machine and tokenised datasets without
+// requiring a human-relationship-specific extractor.
+void extract_generic_canonical_facts(const TextAtom& atom, ProposalExtraction* result) {
+  const auto payload = atom.text;
+  std::smatch m;
+
+  // JSON/JSONL edge record: {"subject":"...","predicate":"...","object":"..."}
+  static const std::regex json_edge(
+      R"REGEX("(?:subject|source|from)"\s*:\s*"([^"]+)"[\s\S]*?"(?:predicate|relation|edge|type)"\s*:\s*"([^"]+)"[\s\S]*?"(?:object|target|to|value)"\s*:\s*"([^"]+)")REGEX",
+      std::regex::icase);
+  if (std::regex_search(payload, m, json_edge) && m.size() >= 4) {
+    add_canonical_fact(result, m[1].str(), normalise_relation_name(m[2].str()),
+                       m[3].str(), atom.id, 0.995);
+  }
+
+  // Delimited edge records: subject<TAB>predicate<TAB>object or subject|predicate|object.
+  static const std::regex delimited_edge(R"(^\s*([^\t|,]+)\s*(?:\t|\|)\s*([^\t|,]+)\s*(?:\t|\|)\s*([^\t|]+)\s*$)");
+  if (std::regex_match(payload, m, delimited_edge) && m.size() >= 4) {
+    const auto predicate = normalise_relation_name(m[2].str());
+    if (predicate != "predicate" && predicate != "relation")
+      add_canonical_fact(result, m[1].str(), predicate, m[3].str(), atom.id, 0.99);
+  }
+
+  // Tokenised edge format. Values may themselves contain whitespace-separated tokens.
+  // [SUBJ] order 104 [/SUBJ] [REL] contains [/REL] [OBJ] line 7 [/OBJ]
+  auto tagged_value = [&](const std::vector<std::string>& tags) -> std::string {
+    const auto lp = lower(payload);
+    for (const auto& tag : tags) {
+      const auto open = "[" + lower(tag) + "]";
+      const auto close = "[/" + lower(tag) + "]";
+      const auto begin = lp.find(open);
+      if (begin == std::string::npos) continue;
+      const auto value_begin = begin + open.size();
+      const auto end = lp.find(close, value_begin);
+      if (end != std::string::npos) return trim(payload.substr(value_begin, end - value_begin));
+    }
+    return {};
+  };
+  const auto token_subject = tagged_value({"SUBJ", "SUBJECT", "S"});
+  const auto token_relation = tagged_value({"REL", "PRED", "PREDICATE", "P"});
+  const auto token_object = tagged_value({"OBJ", "OBJECT", "O"});
+  if (!token_subject.empty() && !token_relation.empty() && !token_object.empty())
+    add_canonical_fact(result, token_subject, normalise_relation_name(token_relation),
+                       token_object, atom.id, 0.985);
+
+  // Compact RDF/N-Triples-inspired form: <subject> <predicate> <object> .
+  static const std::regex rdf_edge(R"(^\s*<([^>]+)>\s+<([^>]+)>\s+<([^>]+)>\s*\.?\s*$)");
+  if (std::regex_match(payload, m, rdf_edge) && m.size() >= 4) {
+    add_canonical_fact(result, m[1].str(), normalise_relation_name(m[2].str()),
+                       m[3].str(), atom.id, 0.995);
+  }
+}

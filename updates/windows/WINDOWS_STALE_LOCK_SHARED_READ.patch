+Status read_text_shared(const std::filesystem::path& path, std::string* contents) {
+  if (!contents) return Status::error(ErrorCode::InvalidInput, "contents pointer is null");
+  HANDLE h = ::CreateFileW(path.wstring().c_str(), GENERIC_READ,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (h == INVALID_HANDLE_VALUE) {
+    return Status::error(ErrorCode::IoError, "CreateFileW shared read failed");
+  }
+  LARGE_INTEGER size{};
+  if (!::GetFileSizeEx(h, &size) || size.QuadPart < 0 || size.QuadPart > 4096) {
+    ::CloseHandle(h);
+    return Status::error(ErrorCode::IoError, "invalid lock file size");
+  }
+  std::string value(static_cast<size_t>(size.QuadPart), '\0');
+  DWORD read = 0;
+  const BOOL ok = value.empty() || ::ReadFile(h, value.data(), static_cast<DWORD>(value.size()), &read, nullptr);
+  ::CloseHandle(h);
+  if (!ok) return Status::error(ErrorCode::IoError, "ReadFile shared read failed");
+  value.resize(read);
+  *contents = std::move(value);
+  return Status::ok();
+}
+
 } // namespace graphene::platform
 #endif

+Status read_text_shared(const std::filesystem::path& path, std::string* contents) {
+  if (!contents) return Status::error(ErrorCode::InvalidInput, "contents pointer is null");
+  std::ifstream in(path, std::ios::binary);
+  if (!in) return Status::error(ErrorCode::IoError, "open read failed");
+  std::ostringstream buffer;
+  buffer << in.rdbuf();
+  if (!in.good() && !in.eof()) return Status::error(ErrorCode::IoError, "read failed");
+  *contents = buffer.str();
+  return Status::ok();
+}
+
 } // namespace graphene::platform

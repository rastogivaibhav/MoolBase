cff-version: 1.2.0
message: "If you use GrapheneDB or its epistemic-control benchmark, cite this software and the associated preprint."
title: "GrapheneDB"
type: software
authors:
  - family-names: "Rastogi"
    given-names: "Vaibhav"
version: "0.6.0-alpha.1"
repository-code: "https://github.com/rastogivaibhav/MoolBase"
abstract: >-
  GrapheneDB is an experimental embedded C++20 evidence and causal-memory
  database with lineage-aware FiberBundles, target-scoped epistemic control,
  bounded frontier-aware recovery, opposition anchors, and compact decision
  receipts for agentic systems.
keywords:
  - evidence lineage
  - epistemic control
  - agent memory
  - graph reasoning
  - provenance
preferred-citation:
  type: article
  title: "GrapheneDB: Lineage-Aware Epistemic Control and Frontier-Aware Evidence Recovery for Agentic Systems"
  authors:
    - family-names: "Rastogi"
      given-names: "Vaibhav"
  year: 2026
  notes: "arXiv identifier pending submission"

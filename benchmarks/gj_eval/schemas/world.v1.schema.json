{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphenedb.local/gj-eval/world.v1.schema.json",
  "title": "GJ-Eval World v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world_id",
    "split",
    "variant",
    "domain",
    "choices",
    "timeline",
    "oracle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "test"
      ]
    },
    "variant": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "cost"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestep",
          "observations"
        ],
        "properties": {
          "timestep": {
            "type": "integer",
            "minimum": 0
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "required": [
        "true_root",
        "decisive_timestep"
      ],
      "properties": {
        "true_root": {
          "type": "string"
        },
        "decisive_timestep": {
          "type": "integer",
          "minimum": 0
        },
        "optimal_test": {
          "type": [
            "string",
            "null"
          ]
        },
        "insufficient_until": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

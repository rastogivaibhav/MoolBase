# Copy to a private operator-controlled location. Do not commit populated values.

# Frozen source identity
EVIDENCE_LAB_RELEASE_BRANCH=release/evidence-lab-alpha.1-rc3
EVIDENCE_LAB_EXPECTED_COMMIT=REPLACE_WITH_EXACT_RC3_COMMIT
GRAPHENEDB_PUBLIC_VERSION=v0.6.0-alpha.1

# Public identity
EVIDENCE_LAB_PUBLIC_HOSTNAME=evidence.REPLACE_WITH_DOMAIN
EVIDENCE_LAB_CHATGPT_SITES_ORIGIN=https://REPLACE_WITH_PUBLISHED_SITE_ORIGIN
EVIDENCE_LAB_PREVIEW_ORIGIN=https://REPLACE_WITH_PRIVATE_PREVIEW_ORIGIN

# Operator and policy pages
EVIDENCE_LAB_OPERATOR_NAME=REPLACE_WITH_LEGAL_OR_OPERATOR_NAME
EVIDENCE_LAB_PRIVACY_CONTACT=REPLACE_WITH_PRIVACY_EMAIL_OR_URL
EVIDENCE_LAB_SECURITY_CONTACT=REPLACE_WITH_SECURITY_EMAIL_OR_URL
EVIDENCE_LAB_HOSTING_REGION=REPLACE_WITH_ACTUAL_HOSTING_REGION

# Kubernetes
EVIDENCE_LAB_KUBE_CONFIG_B64=REPLACE_WITH_BASE64_KUBECONFIG
EVIDENCE_LAB_KUBERNETES_MIN_VERSION=1.30
EVIDENCE_LAB_STORAGE_CLASS=REPLACE_WITH_PRIVATE_RWX_STORAGE_CLASS
EVIDENCE_LAB_TLS_CLUSTER_ISSUER=REPLACE_WITH_CLUSTER_ISSUER
EVIDENCE_LAB_INGRESS_CLASS=nginx
EVIDENCE_LAB_ADMISSION_POLICY_CONFIRMED=false

# Private container registry access
EVIDENCE_LAB_GHCR_USERNAME=REPLACE_WITH_GITHUB_USERNAME
EVIDENCE_LAB_GHCR_PAT=REPLACE_WITH_PACKAGE_READ_TOKEN

# DNS/TLS acceptance
EVIDENCE_LAB_DNS_READY=false
EVIDENCE_LAB_TLS_READY=false

# Release approval
EVIDENCE_LAB_IP_CLEARANCE_CONFIRMED=false
EVIDENCE_LAB_CODE_LICENCE_CONFIRMED=false
EVIDENCE_LAB_SAMPLE_RIGHTS_CONFIRMED=false
EVIDENCE_LAB_PRIVACY_TEXT_APPROVED=false
EVIDENCE_LAB_SECURITY_TEXT_APPROVED=false

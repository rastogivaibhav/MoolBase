+int month_number(const std::string& month) {
+  static const std::unordered_map<std::string, int> months = {
+      {"january",1},{"february",2},{"march",3},{"april",4},{"may",5},{"june",6},
+      {"july",7},{"august",8},{"september",9},{"october",10},{"november",11},{"december",12}};
+  const auto it = months.find(lower_copy(month));
+  return it == months.end() ? 0 : it->second;
+}
+
+struct ParsedDate {
+  int year{0};
+  int month{0};
+  int day{0};
+  bool valid{false};
+};
+
+std::optional<ParsedDate> first_calendar_date(const std::string& text) {
+  static const std::regex pattern(
+      R"((January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2})(?:st|nd|rd|th)?(?:,\s*|\s+)(\d{4}))",
+      std::regex::icase);
+  std::smatch match;
+  if (!std::regex_search(text, match, pattern) || match.size() < 4) return std::nullopt;
+  ParsedDate date;
+  date.month = month_number(match[1].str());
+  date.day = std::stoi(match[2].str());
+  date.year = std::stoi(match[3].str());
+  date.valid = date.month > 0 && date.day > 0 && date.year > 0;
+  return date.valid ? std::optional<ParsedDate>(date) : std::nullopt;
+}
+
+bool earlier_than(const ParsedDate& left, const ParsedDate& right) {
+  if (left.year != right.year) return left.year < right.year;
+  if (left.month != right.month) return left.month < right.month;
+  return left.day < right.day;
+}
+
+bool looks_like_rendered_path(const std::string& answer) {
+  const auto lowered = lower_copy(answer);
+  return answer.find(" -> ") != std::string::npos ||
+         answer.find(" => ") != std::string::npos ||
+         (answer.find('[') != std::string::npos && lowered.find("sentence") != std::string::npos) ||
+         lowered.find("strongest active path") != std::string::npos ||
+         lowered.find("source proposition:") != std::string::npos;
+}
+
+bool natural_question_requires_answer_contract(const std::string& query) {
+  const auto q = lower_copy(trim_copy(query));
+  static const std::vector<std::string> starts = {
+      "who ", "what ", "which ", "when ", "where ", "how ",
+      "are ", "is ", "was ", "were ", "do ", "does ", "did ",
+      "can ", "has ", "have "};
+  return std::any_of(starts.begin(), starts.end(),
+                     [&](const auto& prefix) { return q.rfind(prefix, 0) == 0; });
+}
+
+bool source_supports_united_states(const std::string& payload) {
